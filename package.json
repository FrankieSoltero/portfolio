{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Francisco Soltero's portfolio: build-free 8-bit character sheet at /, Next.js-rendered /papers section.",
  "scripts": {
    "predev": "npm run frame",
    "dev": "next dev",
    "prebuild": "npm run frame",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.drills.json",
    "lint": "eslint --no-error-on-unmatched-pattern room-planner app/room-planner drills app/drills lib/drills.ts scripts content/drills/*/solution e2e playwright.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:drills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/drills-fairness.mts",
    "test:drills-pages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/drills-pages-check.mts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:drills && npm run build && npm run test:drills-pages",
    "frame": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-drill-frame.mts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "drillbox": "file:vendor/drillbox-0.0.0-40f9b05.tgz",
    "feed": "^5.1.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^1.72.0",
    "next": "^15.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    }
  }
}
